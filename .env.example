# ---------------------------------------------------------------------------
# Supabase project (required)
# Copy this file to .env.local and fill in values from your Supabase project
# Settings -> API page. Never commit real values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OR_anon_key_here

# Server-only. Used ONLY in route handlers / server modules for privileged
# operations (e.g. service backfills). Never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed app (used for OAuth/email redirects).
APPLICATION_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OCR provider (optional)
# OCR_PROVIDER = tesseract | http | none
#  - tesseract: local OCR via tesseract.js (ben+eng), no key required.
#  - http: generic remote OCR endpoint (POST image -> JSON extraction).
#  - none: uploads stay manual-entry only.
# ---------------------------------------------------------------------------
OCR_PROVIDER=tesseract
OCR_HTTP_ENDPOINT=
OCR_HTTP_API_KEY=

# Optional AI assistant for alias suggestions / extraction post-processing.
# Server-side only. When absent the app falls back to deterministic matching.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
